{
  "name": "training-ground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local soccer drill designer & animator for youth coaching",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs --open",
