{
  "$schema": "../schema/drill.schema.json",
  "schemaVersion": 1,
  "id": "4v2-moving-rondo",
  "title": "4v2 Moving Rondo",
  "description": "Four outside players keep changing their support angles while two defenders work as a press-cover pair.",
  "tags": [
    "rondo",
    "passing",
    "movement",
    "defending",
    "warmup"
  ],
  "notes": "Use one continuous tempo. The outside four glide to new support angles while the ball travels. On every pass, the defender closest to the receiver presses; the partner protects the split or central lane, so the two exchange roles naturally. When both defenders close the lane, reward the read with an interception, a brief hold, and a controlled pass back to an outside player. Run the live drill for 60–90 seconds before rotating defenders.",
  "themeColor": "#0f766e",
  "pitch": {
    "format": "grid",
    "overrides": {
      "length": 15,
      "width": 15
    }
  },
