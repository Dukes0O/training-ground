{
  "$schema": "../schema/drill.schema.json",
  "schemaVersion": 1,
  "id": "gates-and-turns",
  "title": "Gates and Turns",
  "description": "Find an open gate, carry the ball through it, then turn toward a new space. A simple ball mastery starter with plenty of choices.",
  "tags": ["ball mastery", "dribbling", "warmup", "beginner"],
  "notes": "SETUP: Mark a 20 × 18 m area with two 2 m gates. Start with two players and a ball each; add gates and space as more players join. RUN IT: 1. Look for a free gate. 2. Dribble through it with the ball close. 3. Turn into space. 4. Find a different gate. The animation shows two possible routes; players choose their own. COACH IT: Look up between touches, leave room for the other player, and take a smaller touch before a turn. EASIER: Use wider gates and fewer players. PROGRESS: Call a color or ask for a different turn at each gate. Try a 45-second round, then let players share a turn they used.",
  "themeColor": "#0d9488",
  "pitch": { "format": "grid", "overrides": { "length": 20, "width": 18 } },
  "teams": { "home": { "label": "Dribblers" } },
  "entities": [
    { "kind": "player", "id": "p1", "team": "home", "number": 1 },
    { "kind": "player", "id": "p2", "team": "home", "number": 2 },
    { "kind": "ball", "id": "ball1" },
    { "kind": "ball", "id": "ball2" },
    { "kind": "cone", "id": "gate-a1", "color": "#fbbf24" },
    { "kind": "cone", "id": "gate-a2", "color": "#fbbf24" },
    { "kind": "cone", "id": "gate-b1", "color": "#38bdf8" },
    { "kind": "cone", "id": "gate-b2", "color": "#38bdf8" },
    { "kind": "arrow", "id": "first-gate", "style": "dribble", "from": { "x": 4, "y": 5 }, "to": { "x": 10, "y": 5 }, "fromStep": 0, "toStep": 1 },
    { "kind": "arrow", "id": "second-gate", "style": "dribble", "from": { "x": 16, "y": 13 }, "to": { "x": 10, "y": 13 }, "fromStep": 0, "toStep": 1 }
  ],
  "steps": [
    { "name": "Look for a free gate", "durationMs": 1200, "positions": {
      "p1": { "x": 3, "y": 5 }, "ball1": { "x": 3.8, "y": 5 },
      "p2": { "x": 17, "y": 13 }, "ball2": { "x": 16.2, "y": 13 },
      "gate-a1": { "x": 8, "y": 4 }, "gate-a2": { "x": 8, "y": 6 },
      "gate-b1": { "x": 12, "y": 12 }, "gate-b2": { "x": 12, "y": 14 }
    } },
    { "name": "Carry the ball through", "durationMs": 1900, "positions": {
      "p1": { "x": 10, "y": 5 }, "ball1": { "x": 10.8, "y": 5 },
      "p2": { "x": 10, "y": 13 }, "ball2": { "x": 9.2, "y": 13 }
    } },
    { "name": "Take a touch into space", "durationMs": 1300, "positions": {
      "p1": { "x": 13, "y": 3 }, "ball1": { "x": 13.8, "y": 3 },
      "p2": { "x": 7, "y": 15 }, "ball2": { "x": 6.2, "y": 15 }
    } },
    { "name": "Turn and find the next gate", "durationMs": 1800, "pauseAfterMs": 500, "positions": {
      "p1": { "x": 12, "y": 8, "via": [{ "x": 14, "y": 5 }] },
      "ball1": { "x": 11.2, "y": 8, "via": [{ "x": 14.8, "y": 5 }] },
      "p2": { "x": 8, "y": 10, "via": [{ "x": 6, "y": 13 }] },
      "ball2": { "x": 8.8, "y": 10, "via": [{ "x": 5.2, "y": 13 }] }
    } },
    { "name": "Go through a different gate", "durationMs": 2000, "pauseAfterMs": 800, "positions": {
      "p1": { "x": 14, "y": 13, "via": [{ "x": 10.5, "y": 13 }] },
      "ball1": { "x": 14.8, "y": 13, "via": [{ "x": 11.3, "y": 13 }] },
      "p2": { "x": 6, "y": 5, "via": [{ "x": 9.5, "y": 5 }] },
      "ball2": { "x": 5.2, "y": 5, "via": [{ "x": 8.7, "y": 5 }] }
    } }
  ]
}
