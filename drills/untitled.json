{
  "$schema": "../schema/drill.schema.json",
  "schemaVersion": 1,
  "id": "untitled",
  "title": "Tiki-Taka Gate Rotation",
  "description": "Two runners alternate their own balls through three cone gates, carry to the far line, then work back on the mirrored side.",
  "tags": [
    "passing",
    "combination-play",
    "one-touch",
    "rotation"
  ],
  "notes": "Each runner starts with their own ball and keeps it after reaching the far line. Time every approach so the runner and ball arrive together: start pass, diagonal gate return, square gate return, forward-angle pass, then a controlled carry to the end cone. Work back through the upper gates on the mirrored side. Keep the middle player available on an open body shape and use firm, accurate passes through each gate.",
  "themeColor": "#7c3aed",
  "pitch": {
    "format": "grid",
    "overrides": {
      "length": 28,
      "width": 14.5,
      "gridOn": true
    }
  },
