{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "themeColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "pitch": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "11v11",
            "9v9",
            "8v8",
            "half-11v11",
            "grid"
          ]
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "11v11",
                "9v9",
                "8v8",
                "half-11v11",
                "grid"
              ]
            },
            "overrides": {
              "type": "object",
              "properties": {
                "length": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "gridOn": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "format"
          ],
          "additionalProperties": false
        }
      ]
    },
    "teams": {
      "type": "object",
      "properties": {
        "home": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "fill": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "away": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "fill": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "neutral": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "fill": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "player"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "team": {
                "type": "string",
                "enum": [
                  "home",
                  "away",
                  "neutral"
                ]
              },
              "number": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              },
              "name": {
                "type": "string"
              },
              "position": {
                "type": "string"
              },
              "rosterRef": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "team"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "ball"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "cone",
                  "flat",
                  "minigoal",
                  "ladder",
                  "mannequin",
                  "pole",
                  "hurdle"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "arrow",
                  "zone",
                  "label"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "style": {
                "type": "string",
                "enum": [
                  "pass",
                  "run",
                  "dribble",
                  "shot",
                  "plain"
                ]
              },
              "from": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "ref"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "to": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "ref"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "via": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              },
              "shape": {
                "type": "string",
                "enum": [
                  "rectangle",
                  "ellipse",
                  "polygon"
                ]
              },
              "points": {
                "minItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              },
              "pathMode": {
                "type": "string",
                "enum": [
                  "smooth",
                  "straight"
                ]
              },
              "rect": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "text": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "fromStep": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "toStep": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "durationMs": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pauseAfterMs": {
            "type": "number",
            "minimum": 0
          },
          "ease": {
            "type": "string",
            "enum": [
              "linear",
              "easeIn",
              "easeOut",
              "easeInOut",
              "instant"
            ]
          },
          "positions": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "rotation": {
                  "type": "number"
                },
                "via": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "ease": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "easeIn",
                    "easeOut",
                    "easeInOut",
                    "instant"
                  ]
                },
                "hidden": {
                  "type": "boolean"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "positions"
        ],
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "rev": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "pitch",
    "entities",
    "steps"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/Dukes0O/training-ground/schema/drill.schema.json",
  "title": "Training Ground drill",
  "description": "A soccer drill/animation for the Training Ground app. Units are meters; origin is the pitch's top-left corner. See docs/drill-authoring.md."
}
